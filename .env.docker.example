# Contoh .env untuk stack Docker production.
# Salin: cp .env.docker.example .env  lalu isi nilai yang kosong.
# File .env JANGAN di-commit (sudah ada di .gitignore).

APP_NAME="Rhapsody Studio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# URL publik final, wajib https:// kalau domain sudah mengarah ke VPS.
APP_URL=https://domain-kamu.com
# Host yang dilayani Caddy (domain atau IP VPS). HTTPS otomatis kalau domain.
SITE_HOST=domain-kamu.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

ADMIN_EMAIL=admin@domain-kamu.com
ADMIN_PASSWORD=ganti_dengan_password_sangat_kuat
ADMIN_PHONE=6281234567890

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database = service `mysql` di compose. Jangan ubah DB_HOST/DB_PORT.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rhapsody
DB_USERNAME=rhapsody
DB_PASSWORD=ganti_password_db_kuat
DB_ROOT_PASSWORD=ganti_password_root_kuat

# Migrasi otomatis saat container `app` pertama start. Matikan (false)
# kalau migrasi mau dijalankan manual.
RUN_MIGRATIONS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_HOST=mail.domain-kamu.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@domain-kamu.com
MAIL_PASSWORD=password_email
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@domain-kamu.com
MAIL_FROM_NAME="${APP_NAME}"

FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com/send

BOOKING_HOLD_MINUTES=15

XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_CALLBACK_VERIFICATION_TOKEN=
XENDIT_PLATFORM_ACCOUNT_ID=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_FEE_TYPE=percent
XENDIT_FEE_PERCENT=2.0
XENDIT_FEE_FLAT=0
XENDIT_WITHDRAWAL_MIN=50000
XENDIT_WITHDRAWAL_RATE_LIMIT=5

VITE_APP_NAME="${APP_NAME}"
